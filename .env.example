# Copy this file to .env only if you do not already have a local .env.
# Never commit real keys.
NEATLOGS_API_KEY=
# Separate expiring service-account credential for trace reads. Never reuse the SDK key.
NEATLOGS_TOKEN=
NEATLOGS_PROJECT_ID=00fd5eb9-0f63-473e-babc-4621191e4a4d

# Claude through the hackathon LiteLLM gateway.
LITELLM_API_KEY=
# Use the gateway URL supplied by the organisers.
LITELLM_BASE_URL=
# Use the exact model identifier exposed by that gateway.
LITELLM_MODEL=

# Gemini through its API.
GEMINI_API_KEY=
GEMINI_MODEL=
# mixed: Gemini investigation/review and Claude edits; claude-only: all roles use LiteLLM.
TORQUE_PROVIDER_MODE=mixed

# Backend GitHub access for issues, branches, and pull requests.
GITHUB_TOKEN=
# Explicit controlled publication destination (operator-owned source or fork).
# Token needs Contents read/write and Pull requests read/write on this repository.
TORQUE_PUBLISH_REPOSITORY=

# Local backend API authentication; use a new random value, not a provider key.
TORQUE_OPERATOR_TOKEN=
# Comma-separated owner/repo allowlist. Empty blocks all submissions.
TORQUE_ALLOWED_REPOSITORIES=
# Optional runtime overrides:
# TORQUE_DATABASE=var/torque.sqlite3
# TORQUE_LEASE_SECONDS=60
# TORQUE_HEARTBEAT_SECONDS=10
# TORQUE_POLL_SECONDS=1

# Agent execution: reviewed recipe mapping; example requires real image/suite values.
TORQUE_RECIPES_FILE=
# Explicit conservative prices per million tokens for the actual configured models.
# Use 0 only for verified free quota. Token/call limits still apply; costs are estimates.
LITELLM_INPUT_USD_PER_MILLION=
LITELLM_OUTPUT_USD_PER_MILLION=
GEMINI_INPUT_USD_PER_MILLION=
GEMINI_OUTPUT_USD_PER_MILLION=
TORQUE_MAX_COST_USD=2
TORQUE_MAX_TOKENS=100000
TORQUE_MAX_SECONDS=900
TORQUE_MAX_CALLS=12
TORQUE_RECOVERY_RETRIES=2

# Linux tests on GitHub instead of local Docker (public kokon demo only).
TORQUE_RUNNER=docker
TORQUE_ACTIONS_TOKEN=
TORQUE_ACTIONS_REPOSITORY=davre001/Torque
TORQUE_ACTIONS_REF=main

# GitHub App browser login (separate from local operator PAT).
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_CALLBACK_URL=http://localhost:8000/api/auth/github/callback
TORQUE_FRONTEND_ORIGIN=http://localhost:3000
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TORQUE_SESSION_ENCRYPTION_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# Atomic admission reservations; UTC day; cancellations retain full run cap.
TORQUE_MAX_ACTIVE_RUNS=20
TORQUE_USER_ACTIVE_RUNS=1
TORQUE_USER_DAILY_RUNS=5
TORQUE_USER_DAILY_USD=10
TORQUE_DEPLOYMENT_DAILY_USD=20

# Read-only Entire target history; requires CLI login and mirrored target.
TORQUE_ENTIRE_CONTEXT=0

# Patch guard counts old + new UTF-8 file bytes across all edited files.
# Default 100 KB; the reviewed two-file slider trial uses 150000 in its process.
TORQUE_MAX_PATCH_BYTES=100000

# Opt-in production API boundary. Requires HTTPS App URLs and an EMPTY operator token.
TORQUE_PUBLIC_MODE=0
TORQUE_HTTP_BODY_BYTES=65536
TORQUE_HTTP_IP_PER_MINUTE=120
TORQUE_HTTP_GLOBAL_PER_MINUTE=600
