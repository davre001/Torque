# Copy this file to .env only if you do not already have a local .env.
# Never commit real keys.
NEATLOGS_API_KEY=

# Claude through the hackathon LiteLLM gateway.
LITELLM_API_KEY=
# Use the gateway URL supplied by the organisers.
LITELLM_BASE_URL=
# Use the exact model identifier exposed by that gateway.
LITELLM_MODEL=

# Gemini through its API.
GEMINI_API_KEY=
GEMINI_MODEL=

# Backend GitHub access for issues, branches, and pull requests.
GITHUB_TOKEN=

# Local backend API authentication; use a new random value, not a provider key.
TORQUE_OPERATOR_TOKEN=
# Comma-separated owner/repo allowlist. Empty blocks all submissions.
TORQUE_ALLOWED_REPOSITORIES=
# Optional runtime overrides:
# TORQUE_DATABASE=var/torque.sqlite3
# TORQUE_LEASE_SECONDS=60
# TORQUE_HEARTBEAT_SECONDS=10
# TORQUE_POLL_SECONDS=1
