 .card { position: relative; border-radius: 10px; overflow: hidden; background: var(--surface); aspect-ratio: 1; cursor: pointer; }
 .card img { width: 100%; height: 100%; object-fit: cover; display: block; }
 .card .card-actions { position: absolute; right: 6px; top: 6px; display: none; gap: 4px; }
-.card:hover .card-actions, .card .card-actions.fav { display: flex; }
+.card:hover .card-actions, .card:focus-within .card-actions, .card .card-actions.fav { display: flex; }
 .card .card-actions button { width: 28px; height: 28px; border-radius: 8px; background: var(--scrim); display: grid; place-items: center; color: var(--text); }
 .card .card-meta { position: absolute; left: 0; right: 0; bottom: 0; padding: 18px 8px 6px; font-size: 11px; color: #fff; background: linear-gradient(transparent, rgba(0,0,0,0.6)); display: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
-.card:hover .card-meta { display: block; }
+.card:hover .card-meta, .card:focus-within .card-meta { display: block; }
 
