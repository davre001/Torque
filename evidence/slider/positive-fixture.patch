+.cmp-table td { color: var(--text-3); }
+.cmp-table .us { color: var(--text); font-weight: 560; background: rgba(255,255,255,0.035); }
+.cmp-table thead .us { color: var(--paper); }
+
+/* Article pages (guides) */
+.article { padding: 120px 0 40px; }
+.wrap.narrow { width: min(780px, calc(100% - 32px)); }
+.crumbs { font-size: 14px; color: var(--text-3); margin-bottom: 22px; }
+.crumbs a:hover { color: var(--text); }
+.crumbs span { margin: 0 6px; }
+.article h1 { font-size: clamp(36px, 5.4vw, 58px); letter-spacing: -0.04em; line-height: 1.06; margin: 0; max-width: none; }
+.article h2 { font-size: clamp(26px, 3.2vw, 34px); letter-spacing: -0.03em; line-height: 1.15; margin: 64px 0 0; max-width: none; }
+.article h3 { font-size: 18px; letter-spacing: -0.015em; margin: 28px 0 0; font-weight: 600; }
+.article p, .article li { color: var(--text-2); font-size: 17px; }
+.article p { margin: 16px 0 0; }
+.article strong { color: var(--text); font-weight: 600; }
+.article a:not(.btn) { color: var(--text); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(255,255,255,0.3); }
+.article a:not(.btn):hover { text-decoration-color: var(--text); }
+.article ul, .article ol { margin: 16px 0 0; padding-left: 22px; }
+.article li { margin: 8px 0; }
+.article .table-wrap { margin-top: 24px; }
+.article .cmp-table { min-width: 560px; }
+.lede-left { font-size: 20px !important; margin-top: 22px !important; letter-spacing: -0.01em; }
+.article figure { margin: 44px 0 0; }
+.article figure img { border-radius: 16px; box-shadow: 0 0 0 1px var(--line-hi), 0 40px 120px rgba(0,0,0,0.6); width: 100%; height: auto; }
+.article figcaption { margin-top: 12px; font-size: 14px; color: var(--text-3); text-align: center; }
+.article .term { margin-top: 40px; }
+.article code { font-family: var(--mono); font-size: 0.88em; padding: 2px 6px; border-radius: 6px; background: rgba(255,255,255,0.07); color: var(--text); }
+.article p code, .article li code { overflow-wrap: anywhere; }
+.article pre { margin: 14px 0 0; padding: 16px 18px; border-radius: 14px; background: #0f0f0f; box-shadow: inset 0 0 0 1px var(--line); overflow-x: auto; }
+.article pre code { padding: 0; background: none; font-size: 13.5px; line-height: 1.6; color: #d6d6d6; }
+.note { font-size: 15px !important; color: var(--text-3) !important; }
+.cta-box { margin: 72px 0 40px; padding: 36px; border-radius: var(--radius); background: linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02)); box-shadow: inset 0 0 0 1px var(--line); }
+.cta-box h2 { margin: 0 !important; }
+
+.cmp:focus-visible { outline: 3px solid #fff; outline-offset: 4px; }
