+.mask-demo .path { stroke-dasharray: 3000; stroke-dashoffset: 3000; transition: stroke-dashoffset 2.6s cubic-bezier(0.65, 0, 0.35, 1); }
+.mask-demo.in .path { stroke-dashoffset: 0; }
