+.chips { display: flex; flex-wrap: wrap; gap: 8px; }
+.chip { padding: 8px 14px; border-radius: 999px; font-size: 13.5px; background: rgba(255,255,255,0.06); box-shadow: inset 0 0 0 1px var(--line); color: var(--text-2); }
+.chip.on { background: var(--paper); color: var(--ink); box-shadow: none; font-weight: 560; }
+.timeline { display: flex; align-items: center; gap: 0; }
