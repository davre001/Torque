+
+/* Agent */
+.split { display: grid; gap: 48px; align-items: center; grid-template-columns: 1fr; }
+.split > * { min-width: 0; } /* long commands scroll inside their box instead of widening the page */
+@media (min-width: 980px) { .split { grid-template-columns: 1fr 1.12fr; gap: 72px; } }
+.term { border-radius: 18px; background: #0c0c0c; box-shadow: 0 0 0 1px var(--line-hi), 0 40px 120px rgba(0,0,0,0.6); overflow: hidden; font-family: var(--mono); font-size: 13.5px; line-height: 1.7; }
+.term-head { height: 40px; display: flex; align-items: center; gap: 8px; padding: 0 16px; background: #151515; font-family: var(--font); font-size: 12.5px; color: var(--text-3); }
+.term-head i { width: 11px; height: 11px; border-radius: 50%; background: #333; }
+.term-body { padding: 20px 22px 22px; color: #cfcfcf; overflow-x: auto; }
