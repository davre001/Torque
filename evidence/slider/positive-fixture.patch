+  --line: rgba(255, 255, 255, 0.08);
+  --line-hi: rgba(255, 255, 255, 0.14);
+  --text: #f2f1ed;
+  --text-2: rgba(242, 241, 237, 0.66);
+  --text-3: rgba(242, 241, 237, 0.42);
+  --paper: #f7f6f2;
+  --ink: #0d0d0d;
+  --radius: 22px;
+  --max: 1200px;
+  --font: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
