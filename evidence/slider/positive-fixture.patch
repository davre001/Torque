+
+/* Final */
+.final { padding: 160px 0 120px; text-align: center; position: relative; overflow-x: clip; }
+.final::before { content: ""; position: absolute; left: 50%; top: 40px; width: 1100px; height: 600px; transform: translateX(-50%); background: radial-gradient(ellipse at center, rgba(247,246,242,0.08), transparent 60%); pointer-events: none; }
