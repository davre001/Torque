+
+/* Maker */
+.maker { display: inline-flex; align-items: center; gap: 14px; margin-top: 56px; padding: 10px 22px 10px 10px; border-radius: 999px; background: var(--card); box-shadow: inset 0 0 0 1px var(--line); text-align: left; transition: background 0.2s; }
