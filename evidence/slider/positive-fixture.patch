+.lede { font-size: clamp(17px, 2vw, 21px); color: var(--text-2); max-width: 36em; margin: 26px auto 0; letter-spacing: -0.012em; }
+.ctas { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 36px; }
+.fine { margin-top: 18px; font-size: 13.5px; color: var(--text-3); }
+
+.showreel { position: relative; margin: 72px auto 0; max-width: 1120px; }
+.showreel .frame { position: relative; z-index: 101; /* above the page grain (body::before): a translucent layer over a playing video greys it in Chrome */ border-radius: 22px; overflow: hidden; background: #000 url("assets/kokon-poster.jpg?v=2") center / cover; box-shadow: 0 0 0 1px var(--line-hi), 0 60px 160px rgba(0,0,0,0.75), 0 0 120px rgba(247,246,242,0.06); aspect-ratio: 16 / 9; }
+.showreel video { width: 100%; height: 100%; object-fit: cover; }
+.reel-link { margin: 18px 0 0; text-align: center; font-size: 14px; }
+.reel-link a { color: var(--text-3); text-decoration: underline; text-underline-offset: 3px; }
+.reel-link a:hover { color: var(--text); }
+.showreel .glow { position: absolute; inset: 8% 4% -6%; background: radial-gradient(ellipse at center, rgba(255,214,140,0.16), transparent 65%); filter: blur(40px); z-index: -1; }
+.sound { position: absolute; right: 18px; bottom: 18px; height: 44px; padding: 0 18px; border-radius: 999px; background: rgba(0,0,0,0.6); backdrop-filter: blur(10px); font-size: 15px; font-weight: 600; cursor: pointer; color: #fff; display: inline-flex; align-items: center; gap: 8px; box-shadow: inset 0 0 0 1px rgba(255,255,255,0.15); }
+
+/* Runs on */
+.runs { padding: 64px 0 24px; text-align: center; }
+.runs p { font-size: 13px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-3); margin: 0 0 22px; }
+.runs ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 14px 44px; }
+.runs li { display: flex; align-items: center; gap: 10px; color: var(--text-2); font-weight: 560; font-size: 17px; letter-spacing: -0.01em; }
+.runs svg { width: 24px; height: 24px; fill: currentColor; }
+
+/* Sections */
+section { position: relative; }
+.sec { padding: 120px 0 0; }
+.kicker { font-size: 13px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-3); margin: 0 0 16px; }
+h2 { font-size: clamp(36px, 5.6vw, 68px); line-height: 1.04; letter-spacing: -0.042em; font-weight: 670; margin: 0; max-width: 14em; }
+.sec-lede { font-size: 19px; color: var(--text-2); max-width: 34em; margin: 20px 0 0; letter-spacing: -0.01em; }
+.center { text-align: center; }
+.center h2, .center .sec-lede { margin-left: auto; margin-right: auto; }
+
+/* Compare */
+.studio { margin-top: 48px; border-radius: 28px; background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.015)); box-shadow: inset 0 0 0 1px var(--line); padding: 14px; }
+.tabs { display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; padding: 4px; background: rgba(0,0,0,0.35); border-radius: 16px; width: max-content; max-width: 100%; margin: 0 auto 14px; }
+.tabs::-webkit-scrollbar { display: none; }
+.tab { height: 38px; padding: 0 16px; border-radius: 12px; font-size: 14.5px; font-weight: 520; color: var(--text-2); white-space: nowrap; transition: background 0.2s, color 0.2s; }
+.tab:hover { color: var(--text); }
+.tab.on { background: var(--paper); color: var(--ink); }
+.cmp { position: relative; border-radius: 16px; overflow: hidden; background: #000; user-select: none; touch-action: pan-y; cursor: ew-resize; aspect-ratio: 16 / 9; }
+.cmp img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; pointer-events: none; }
+.cmp .before { clip-path: inset(0 calc(100% - var(--split, 50%)) 0 0); }
