+.btn .tag { font-size: 11.5px; font-weight: 600; padding: 2px 7px; border-radius: 6px; background: rgba(255,255,255,0.1); color: var(--text-2); letter-spacing: 0.02em; }
+
+/* Hero */
+.hero { position: relative; padding: 148px 0 40px; text-align: center; overflow-x: clip; }
