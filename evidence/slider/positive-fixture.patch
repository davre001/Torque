+.timeline .t.sel { outline-color: var(--text); }
+.timeline .t img { width: 100%; height: 100%; object-fit: cover; }
+.timeline .j { width: 22px; height: 2px; background: var(--line-hi); flex: none; }
+.timeline .lbls { display: flex; gap: 0; margin-top: 10px; font-size: 12px; color: var(--text-3); }
+.big-num { font-size: 64px; font-weight: 680; letter-spacing: -0.05em; line-height: 1; }
