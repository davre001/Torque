+.copy { margin-top: 26px; display: flex; align-items: center; gap: 10px; padding: 12px 12px 12px 16px; border-radius: 14px; background: #0f0f0f; box-shadow: inset 0 0 0 1px var(--line); font-family: var(--mono); font-size: 13px; color: var(--text-2); }
