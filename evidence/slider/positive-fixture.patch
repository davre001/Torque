+
+/* Steps + comparison */
+.step { display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--paper); color: var(--ink); font-weight: 650; font-size: 15px; margin-bottom: 18px; }
+.table-wrap { margin-top: 44px; overflow-x: auto; border-radius: var(--radius); box-shadow: inset 0 0 0 1px var(--line); background: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.012)); }
