+.icon svg { width: 20px; height: 20px; stroke: var(--text); fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
+.mask-demo { position: relative; border-radius: 14px; overflow: hidden; aspect-ratio: 16 / 9; }
+.mask-demo img { width: 100%; height: 100%; object-fit: cover; }
