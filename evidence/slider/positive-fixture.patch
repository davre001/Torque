+.cmp .handle span { position: absolute; top: 50%; left: 50%; width: 44px; height: 44px; margin: -22px 0 0 -22px; border-radius: 50%; background: #fff; box-shadow: 0 4px 18px rgba(0,0,0,0.45); display: grid; place-items: center; color: #111; }
+.cmp .lbl { position: absolute; top: 14px; padding: 4px 10px; border-radius: 8px; font-size: 12.5px; color: #fff; background: rgba(0,0,0,0.55); backdrop-filter: blur(8px); pointer-events: none; }
+.cmp .lbl.l { left: 14px; } .cmp .lbl.r { right: 14px; }
+.cmp .bg-blur { position: absolute; inset: -40px; width: calc(100% + 80px); height: calc(100% + 80px); object-fit: cover; filter: blur(40px) brightness(0.35) saturate(1.2); transform: scale(1.1); }
+.promptbar { margin-top: 14px; display: flex; align-items: center; gap: 14px; padding: 14px 14px 14px 20px; border-radius: 18px; background: #1a1a1a; box-shadow: inset 0 0 0 1px var(--line); }
+.promptbar .mode { flex: none; font-size: 12.5px; font-weight: 560; padding: 4px 10px; border-radius: 8px; background: rgba(255,255,255,0.08); color: var(--text-2); }
+.promptbar .txt { flex: 1; min-width: 0; font-size: 16px; color: var(--text); letter-spacing: -0.01em; }
+.promptbar .send { flex: none; width: 38px; height: 38px; border-radius: 50%; background: var(--paper); color: var(--ink); display: grid; place-items: center; }
+.honest { margin-top: 18px; text-align: center; font-size: 13.5px; color: var(--text-3); }
+
+/* Bento */
+.bento { margin-top: 56px; display: grid; gap: 16px; grid-template-columns: 1fr; }
+@media (min-width: 900px) { .bento { grid-template-columns: repeat(6, 1fr); } .b-wide { grid-column: span 4; } .b-mid { grid-column: span 3; } .b-small { grid-column: span 2; } }
+.card { position: relative; border-radius: var(--radius); background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.018)); box-shadow: inset 0 0 0 1px var(--line); padding: 30px; overflow: hidden; min-height: 280px; display: flex; flex-direction: column; }
+.card h3 { margin: 0; font-size: 24px; letter-spacing: -0.035em; font-weight: 640; line-height: 1.15; }
+.card p { margin: 10px 0 0; color: var(--text-2); font-size: 15.5px; max-width: 30em; }
+.card .vis { margin-top: auto; padding-top: 26px; }
