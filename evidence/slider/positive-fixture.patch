- "@context": "https://schema.org",
- "@type": "FAQPage",
- "mainEntity": [
-  {
-   "@type": "Question",
-   "name": "Is it really free?",
-   "acceptedAnswer": {
-    "@type": "Answer",
-    "text": "Yes. Kokon is open source under the GNU AGPL-3.0 license. No account, no credits, no subscription. It uses your own GPU, so there is nothing to pay for."
-   }
-  },
-  {
-   "@type": "Question",
-   "name": "How do I run Qwen-Image 2.1 locally without ComfyUI?",
-   "acceptedAnswer": {
-    "@type": "Answer",
-    "text": "Install Kokon and let its setup download the model. Kokon runs Qwen-Image 2.1 through stable-diffusion.cpp, a native engine, so there is no Python, no ComfyUI and no workflow to build. The step-by-step guide is at kokon.app/qwen-image-2-1-local."
-   }
-  },
-  {
-   "@type": "Question",
-   "name": "Which model does it use?",
-   "acceptedAnswer": {
-    "@type": "Answer",
-    "text": "Qwen-Image 2.1 Turbo, the official 8-step version of Qwen's image model, which both creates and edits images and leads the open-weights image-editing rankings."
-   }
-  },
-  {
-   "@type": "Question",
-   "name": "Does it work on AMD or Intel GPUs?",
-   "acceptedAnswer": {
-    "@type": "Answer",
-    "text": "Yes, in beta, through the Vulkan engine on Windows with 12 GB of VRAM or more. On NVIDIA it uses CUDA; on Apple Silicon Macs it uses Metal."
-   }
-  },
-  {
-   "@type": "Question",
-   "name": "My GPU has 8 GB. Will it work?",
-   "acceptedAnswer": {
-    "@type": "Answer",
-    "text": "Not well today. 12 GB is the smallest size that gives good results with this model. On a Mac, 16 GB of unified memory works but slowly; 32 GB is recommended."
-   }
-  },
-  {
-   "@type": "Question",
-   "name": "Can Claude Code or Cursor generate images with it?",
-   "acceptedAnswer": {
-    "@type": "Answer",
-    "text": "Yes. Kokon ships an MCP server: register it once and any MCP client can create, edit, inpaint, expand and upscale images on your GPU, for free and without an API key."
-   }
-  },
-  {
-   "@type": "Question",
-   "name": "Is it an alternative to Photoshop Generative Fill?",
-   "acceptedAnswer": {
-    "@type": "Answer",
-    "text": "For many edits, yes: paint an area and describe what should be there, or remove, replace and add objects. It runs offline and costs nothing, but it is an AI editor, not a full layer-based image editor."
-   }
-  },
-  {
-   "@type": "Question",
-   "name": "Can I use the images commercially?",
-   "acceptedAnswer": {
-    "@type": "Answer",
-    "text": "Not with the default model. The app is open source (AGPL-3.0), but Qwen-Image 2.1 is released under the Qwen Research License: research and evaluation only, no commercial use without a license from the Qwen team. The optional upscaler is also non-commercial (CC BY-NC-SA 4.0)."
-   }
-  },
-  {
-   "@type": "Question",
-   "name": "Windows says the app is unrecognized. Is it safe?",
-   "acceptedAnswer": {
-    "@type": "Answer",
-    "text": "The beta installer is not code-signed yet, so SmartScreen warns about it. Click \"More info\" and then \"Run anyway\". The code is public and every download the app makes is checked against a pinned hash."
-   }
-  },
-  {
-   "@type": "Question",
-   "name": "macOS says Kokon cannot be opened. What do I do?",
-   "acceptedAnswer": {
-    "@type": "Answer",
-    "text": "The beta is not notarized by Apple yet, so macOS blocks it the first time. Try to open it once, then go to System Settings, Privacy & Security, scroll down and click \"Open Anyway\". You only do this once; in-app updates don't trigger it again."
-   }
-  },
-  {
-   "@type": "Question",
-   "name": "Does it work offline?",
-   "acceptedAnswer": {
-    "@type": "Answer",
-    "text": "Yes. After setup has downloaded the models, everything runs offline."
-   }
-  }
- ]
-}
